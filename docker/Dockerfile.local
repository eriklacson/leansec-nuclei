# Generated by Claude Code
# See decisions/ADR-007-python-in-container.md for the runtime split:
# bash entrypoint dispatches cloud I/O; scan.py owns scan execution + YAML parsing.

# Base aligned with the planned vmctl image; same base for both containers in the repo.
FROM python:3.12-slim

# Pin Nuclei version. Override at build with --build-arg NUCLEI_VERSION=vX.Y.Z.
ARG NUCLEI_VERSION=v3.4.10

# Install Nuclei using only Python stdlib (urllib + zipfile). The slim base
# already ships ca-certificates and Python — no apt, curl, or unzip needed.
# Asset naming follows nuclei_<X.Y.Z>_linux_amd64.zip; strip the leading 'v'.
RUN python - <<EOF
import os, urllib.request, zipfile
v = "${NUCLEI_VERSION}".lstrip("v")
url = f"https://github.com/projectdiscovery/nuclei/releases/download/v{v}/nuclei_{v}_linux_amd64.zip"
urllib.request.urlretrieve(url, "/tmp/nuclei.zip")
with zipfile.ZipFile("/tmp/nuclei.zip") as z:
    z.extract("nuclei", "/usr/local/bin/")
os.chmod("/usr/local/bin/nuclei", 0o755)
os.remove("/tmp/nuclei.zip")
EOF

# Bake Nuclei templates into the image so UPDATE_TEMPLATES=false works in tests
# and air-gapped environments without a runtime network call.
RUN nuclei -update-templates -silent

# Runtime python deps: pyyaml for scan profiles; google-cloud-storage for GCS
# config download and results upload in cloud mode (replaces gcloud CLI).
RUN pip install --no-cache-dir pyyaml==6.0.2 google-cloud-storage

WORKDIR /app

# Build context = repo root. profiles.yaml is baked in via scanner/profiles/.
COPY scanner/ /app/scanner/
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Default to local mode; overridable at runtime.
ENV CLOUD_PROVIDER=local \
    UPDATE_TEMPLATES=true \
    PYTHONUNBUFFERED=1

VOLUME ["/app/deployments", "/app/results"]

ENTRYPOINT ["/app/entrypoint.sh"]
